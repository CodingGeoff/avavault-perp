PRIVATE_KEY=0xyour_private_key_here
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
OPERATOR_ADDRESS=0xoptional
LIQUIDITY_AVAX=2000000000000000000
LIQUIDITY_RWA=1000000000000000000000

# live_settle_v2_proof.mjs 用到的一次性 Fuji 测试网账户私钥（仅供本地测试，没有真实价值）：
DEMO_OPERATOR_KEY=
DEMO_TRADER_A_KEY=

# ---------------------------------------------------------------------------
# DeployPerpMarginAccount.s.sol / script/smoke_perp_margin.sh 的部署与冒烟参数
# （都有内置默认值；换网络/换抵押品/换日期部署时按下面注释核对后覆盖）
# ---------------------------------------------------------------------------

# 保证金代币：Fuji 上的 mUSDC（6 位小数，faucet() 可公开领取）
MARGIN_TOKEN=0x206d1B4D35c1f081C82939F1d97A05B5cb5BEF93

# 已部署的 MultiCollateralVaultV2（RWA 抵押估值 totalAccountValue 的来源）
COLLATERAL_VAULT=0xb999cb61A4fb2FE71d1C5FBA7aD506F619dD7884

# quote 代币（当前部署为 WAVAX）的美元价 ×1e6 —— 部署当天按市价核对后再跑。
# 例：WAVAX = $9.62 -> 9620000（2026-10-15 部署时取值）
QUOTE_PRICE_E6=9620000

# 标记价初值：与演示盘口同锚即可（当前演示盘口锚在 2500）
INITIAL_MARK_PRICE=2500

# 冒烟脚本可覆盖的参数（默认值 = 当前证据里的那一组）
# DEPOSIT=1000000
# INSURANCE=100000
# SIZE=40
# PRICE=2500
# LEV=20
# NEW_MARK=2350
