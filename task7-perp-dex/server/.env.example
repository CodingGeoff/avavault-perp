PORT=4000
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# 以下两个留空则只跑链下撮合演示，不做链上结算；部署 Task7 合约后回填即可打通链上结算
VAULT_ADDRESS=
OPERATOR_PRIVATE_KEY=
# RWA 抵押估值接入（MultiCollateralVaultV2.totalAccountValue）；留空则关闭该保证金来源
MULTICOLLATERAL_VAULT_ADDRESS=0xb999cb61A4fb2FE71d1C5FBA7aD506F619dD7884
# quote 代币（当前部署为 WAVAX）的美元参考价，例如 35.25；不填则 RWA 估值只展示、不计入可用保证金
MARGIN_QUOTE_USD_PRICE=
# true 时限价买单在撮合前校验综合保证金（Vault 余额 + 已计入的 RWA 估值），不足返回 403
MARGIN_ENFORCE=false
